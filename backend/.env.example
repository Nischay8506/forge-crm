# Copy to backend/.env and fill in. Never commit .env.
ENVIRONMENT=development

# App connects as forge_app (no superuser, no BYPASSRLS) so row-level security applies.
DATABASE_URL=postgresql+asyncpg://forge_app:CHANGE_ME@localhost:5432/forge
# Migrations and admin CLI run as the schema owner.
MIGRATION_DATABASE_URL=postgresql+asyncpg://forge_owner:CHANGE_ME@localhost:5432/forge
# Password the first migration gives the forge_app role (must match DATABASE_URL).
APP_DB_PASSWORD=CHANGE_ME

REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME

CORS_ORIGINS=["http://localhost:5173"]

# LLM providers (decision 3C). Use NEW keys, not the ones in the old CRM .env.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_MONTHLY_BUDGET_USD=50

# Data Steward (F12.1). Defaults shown; leave commented unless changing.
# STEWARD_NAME_ONLY_AUTO_MERGE=false   # decision S3: keep false (option b would set true)
# STEWARD_EMBEDDINGS=true              # meaning match; only runs when GEMINI_API_KEY is set

# Integrations (F12.6). Encrypts stored ERP credentials (decision E8). Generate with:
#   uv run python -m app.cli new-credential-key
# Rotate: put the new key FIRST, run `uv run python -m app.cli rotate-credentials`,
# then remove the old key. Never reuse a key from another environment.
CREDENTIAL_KEYS=

# Audit trail (F12.4). Signs the hourly seals of the audit chain (decision R3 A).
# Generate with: uv run python -m app.cli new-seal-key
# Rotate: put the new key FIRST and keep the old one after it so its seals can still
# be checked. Keep a copy of these keys somewhere other than this server.
AUDIT_SEAL_KEYS=

# Encrypts the audit trail's evidence (Step 4 safeguard 1). REQUIRED: without it
# nothing that writes to the audit trail can run. Generate with:
#   uv run python -m app.cli new-evidence-key
# Rotate: put the new key FIRST, run `uv run python -m app.cli rotate-evidence`, then
# remove the old key. Losing it makes the evidence unreadable: keep a copy off this server.
EVIDENCE_KEYS=

# Browser push notifications for the approval inbox (decision H5). Optional: without
# them Forge works and the inbox says alerts are not set up. Generate with:
#   uv run python -m app.cli new-push-keys
# then restart the API and the worker. New keys mean everyone turns alerts on again.
# Push needs HTTPS (or localhost) in the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Email (Step 6, F12.5). Where people open Forge's screens: links in emails to staff,
# e.g. an approval card. The unsubscribe link in promotional email uses PUBLIC_BASE_URL,
# which customers must be able to open (a public https address, not localhost).
# The email account itself is set up on Messages > Settings (password stored with
# CREDENTIAL_KEYS). Email starts in the Test inbox until an admin switches it live.
APP_BASE_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000

# Enquiries (Phase 2, M1). Raw emails and attachments are kept here, encrypted (their keys
# are wrapped with EVIDENCE_KEYS); at most EMAIL_MAX_MB per email (decision N9 A).
FILE_STORE_DIR=var/files
EMAIL_MAX_MB=25
# Reading the sales mailbox (N3 A). IMAP needs nothing here. Gmail and Microsoft 365 sign-in
# need Forge's own app registrations (N4 A), with the redirect address
# <PUBLIC_BASE_URL>/api/v1/public/mail/oauth/gmail/callback (or .../microsoft/callback).
# Without them the Connect button says what is missing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Optional: Gmail's instant notification through Google Pub/Sub (projects/<id>/topics/<name>).
# Forge checks every MAIL_POLL_SECONDS anyway.
GMAIL_PUBSUB_TOPIC=
MAIL_POLL_SECONDS=60
